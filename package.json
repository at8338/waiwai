    "start": "node server/index.ts"
  },
  "dependencies": {
    "openid-client": "^6.8.8",
    "phaser": "^3.90.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}

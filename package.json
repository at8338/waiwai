{
  "name": "waiwai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --test src/game/*.test.ts src/audio/*.test.ts src/slack/*.test.ts server/*.test.ts",
    "build": "npm run check && vite build",
    "preview": "node server/index.ts",
    "start": "node server/index.ts",
    "test:load": "node tests/load-office.ts",
    "infra:check": "npm run infra:azure:check && npm run infra:gcp:check",
    "infra:fmt": "terraform fmt -recursive infra-azure && terraform fmt -recursive infra-gcp",
    "test:chat-load": "node tests/load-chat.ts",
    "infra:azure:check": "node scripts/azure/check.mjs",
    "infra:gcp:check": "node scripts/gcp/check.mjs"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "openid-client": "^6.8.8",
    "phaser": "^3.90.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}

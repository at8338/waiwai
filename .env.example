# Slack app > Basic Information > App Credentials (server only; never prefix with VITE_)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Register this exact HTTPS URL in Slack app > OAuth & Permissions > Redirect URLs
SLACK_REDIRECT_URI=

# Production: restrict entry to your company's verified Slack workspace
REQUIRE_SLACK_LOGIN=false
SLACK_TEAM_ID=
# coturn REST credentials (server only). Set both, or leave both empty for local P2P.
TURN_URLS=
TURN_SHARED_SECRET=

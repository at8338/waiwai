# Slack app > Basic Information > App Credentials (server only; never prefix with VITE_)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Register this exact HTTPS URL in Slack app > OAuth & Permissions > Redirect URLs
SLACK_REDIRECT_URI=

# Production: restrict entry to your company's verified Slack workspace
REQUIRE_SLACK_LOGIN=false
SLACK_TEAM_ID=
# coturn REST credentials (server only). Set both, or leave both empty for local P2P.
TURN_URLS=
TURN_SHARED_SECRET=

# Shared objects are stored outside the public dist directory.
WAIWAI_DATA_FILE=.local/office-objects.json
# Verified Slack members remembered for offline search; server-only storage.
WAIWAI_MEMBERS_FILE=.local/office-members.json
# Shared favorites and per-object URL selections. Do not commit internal URLs.
WAIWAI_LINKS_FILE=.local/office-links.json
WAIWAI_ANNOUNCEMENTS_FILE=.local/office-announcements.json
WAIWAI_BIRTHDAYS_FILE=.local/office-birthdays.json

# Microsoft Entra ID (single tenant); secret stays server-side.
# Register HTTPS callback in Entra app registration > Authentication > Web.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=
# true requires Microsoft sign-in even when Slack sign-in is configured.
REQUIRE_ENTRA_LOGIN=false

# Persistent chat database. Includes DM/history/read receipts and Slack outbox.
WAIWAI_CHAT_FILE=.local/office-chat.sqlite
# Opt-in global-chat bridge only; never exports DMs or room chat.
SLACK_CHAT_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHAT_TEAM_ID=
SLACK_CHAT_CHANNEL_ID=
SLACK_CHAT_CHANNEL_NAME="#waiwai"

# Azure deployment requires an enabled all-user Entra MFA policy (read-only Graph preflight).
# ENTRA_MFA_POLICY_ID=00000000-0000-0000-0000-000000000000
# WAIWAI_PERSONAL_FILE=.local/office-personal.sqlite

# Shared administrator policy; stored beside office objects by default.
# WAIWAI_POLICY_FILE=.local/office-policy.json
# Optional immutable administrator ID. Required for Microsoft administrator login.
# WAIWAI_ADMIN_ACCOUNT_ID=entra:<tenant UUID>:<tt-asahara object UUID>
# Without an explicit ID, verified Slack email tt-asahara@kddi.com bootstraps
# the administrator; the first saved edit pins that Slack workspace/user ID.
